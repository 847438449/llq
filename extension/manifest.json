{
  "manifest_version": 3,
  "name": "AI Browser Agent Side Panel",
  "version": "0.1.0",
  "description": "Send current tab context to AI browser agent backend and view execution results.",
  "permissions": ["activeTab", "tabs", "storage", "sidePanel"],
  "host_permissions": ["<all_urls>", "http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI Browser Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
